{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "private-music",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "music.josefyang.com", "custom_domain": true}],
  "main": "server/index.ts",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music",
      "database_id": "4fd0a8d7-973a-4374-b490-cf6a438785f2",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "private-music" }],
}
