{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "private-music",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "music.josefyang.com", "custom_domain": true}],
  "main": "server/index.ts",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "private-music" }],
  "vars": {
    "ACCESS_ISSUER": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE",
    "ALLOWED_EMAIL": "you@example.com",
  },
}
