{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Still theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "mode",
    "colors",
    "font",
    "radius"
  ],
  "properties": {
    "format": {
      "const": "still-theme"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[-a-z0-9]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "mode": {
      "enum": ["light", "dark"]
    },
    "font": {
      "enum": ["sans", "mono"]
    },
    "radius": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "raised",
        "text",
        "muted",
        "border",
        "accent",
        "accentText",
        "danger",
        "focus"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "raised": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentText": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "danger": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "focus": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    }
  }
}
